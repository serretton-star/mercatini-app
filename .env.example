# === VARIABILI D'AMBIENTE — MERCATINI APP ===
# Copia in .env e compila i valori reali. MAI committare .env nel repo.

FLASK_ENV=development

# Genera con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=GENERA_CHIAVE_SICURA_MIN_32_CHAR

# PostgreSQL locale per sviluppo
DATABASE_URL=postgresql://mercatini_user:password@localhost/mercatini_db

# Anthropic (Chat AI — Fase 4b)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
CHAT_MAX_IMAGE_SIZE_MB=5
CHAT_SESSION_TIMEOUT_MIN=30
